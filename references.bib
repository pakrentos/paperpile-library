@ARTICLE{Cho2024-dx,
  title         = "A systematic review of knowledge Tracing and Large Language
                   Models in education: Opportunities, issues, and future
                   research",
  author        = "Cho, Yongwan and AlMamlook, Rabia Emhamed and Gharaibeh,
