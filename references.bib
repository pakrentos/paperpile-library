@ARTICLE{Xiong2025-lh,
  title         = "{CLLMRec}: {LLM}-powered cognitive-aware concept
                   recommendation via Semantic Alignment and Prerequisite
                   Knowledge Distillation",
  author        = "Xiong, Xiangrui and Lu, Yichuan and Pan, Zifei and Sun, Chang",
  journal       = "arXiv [cs.IR]",
  abstract      = "The growth of Massive Open Online Courses (MOOCs) presents
                   significant challenges for personalized learning, where
                   concept recommendation is crucial. Existing approaches
                   typically rely on heterogeneous information networks or
                   knowledge graphs to capture conceptual relationships,
                   combined with knowledge tracing models to assess learners'
