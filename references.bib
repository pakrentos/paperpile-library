@ARTICLE{Kobler2022-tj,
  title     = "{SPD} domain-specific batch normalization to crack interpretable
               unsupervised domain adaptation in {EEG}",
  author    = "Kobler, Reinmar J and Hirayama, J and Zhao, Qibin and Kawanabe, M",
