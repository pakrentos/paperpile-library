@ARTICLE{Maron2019-ve,
  title     = "Provably powerful graph networks",
  author    = "Maron, Haggai and Ben-Hamu, Heli and Serviansky, Hadar and
               Lipman, Y",
  journal   = "Neural Inf Process Syst",
  publisher = "proceedings.neurips.cc",
  volume    = "abs/1905.11136",
  abstract  = "Recently, the Weisfeiler-Lehman (WL) graph isomorphism test was
