}

@ARTICLE{Ju2023-qy,
  title     = "Tensor-{CSPNet}: A novel geometric deep learning framework for
               motor imagery classification",
  author    = "Ju, Ce and Guan, Cuntai",
  journal   = "IEEE Trans. Neural Netw. Learn. Syst.",
